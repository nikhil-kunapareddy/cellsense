# CellSense reads API keys from the environment or from a .env file in the
# working directory. Set the key for whichever provider you use — you only need
# one. Copy this file to `.env` and fill in the values.
#
#   cp .env.example .env

# --model anthropic  /  --model anthropic:claude-opus-5
# Curated ids: claude-fable-5-1, claude-opus-5, claude-opus-4-8, claude-sonnet-5,
# claude-sonnet-4-6, claude-haiku-4-5. Note that the Claude 5 generation and
# Opus 4.7/4.8 reject `temperature` -- the provider omits it for those models, so
# the `temperature` config knob only applies to the older ids (see
# cellsense/providers/anthropic.py).
ANTHROPIC_API_KEY=

# --model openai:gpt-...
OPENAI_API_KEY=

# --model gemini:gemini-2.5-flash
GEMINI_API_KEY=

# --model groq:openai/gpt-oss-120b
GROQ_API_KEY=

# --model llama:Llama-3.3-70B-Instruct
# Meta's hosted Llama API (api.llama.com) was retired on 2026-07-06 -- "llama"
# is now a bring-your-own OpenAI-compatible Llama host, not a Meta-hosted one.
# Both vars below are REQUIRED (no default endpoint):
#   LLAMA_API_KEY   your chosen host's API key
#   LLAMA_BASE_URL  that host's OpenAI-compatible base URL, e.g. one of:
#                     https://api.together.xyz/v1        (Together AI)
#                     https://bedrock-runtime.<region>.amazonaws.com/openai/v1  (AWS Bedrock)
#                     https://api.fireworks.ai/inference/v1                     (Fireworks)
#                     http://localhost:8000/v1                                  (self-hosted vLLM)
# Model ids are host-specific too -- e.g. Together names this model
# "meta-llama/Llama-3.3-70B-Instruct-Turbo", not "Llama-3.3-70B-Instruct".
LLAMA_API_KEY=
LLAMA_BASE_URL=
